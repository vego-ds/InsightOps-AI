# InsightOps-AI local environment template
# Copy this file to `.env` for local testing. Never commit `.env`.

# OpenRouter credentials for optional LLM-backed routing and narrative features.
# Preferred application-scoped variable:
INSIGHTOPS_OPENROUTER_API_KEY=

# Compatibility fallback:
# If INSIGHTOPS_OPENROUTER_API_KEY is unset, the application also checks
# the standard OPENROUTER_API_KEY environment variable.
OPENROUTER_API_KEY=

# OpenRouter model selection.
# Default in insightops/config.py: "openrouter/auto"
INSIGHTOPS_OPENROUTER_MODEL=openrouter/auto

# OpenRouter OpenAI-compatible API base URL.
# Default in insightops/config.py: "https://openrouter.ai/api/v1"
INSIGHTOPS_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional narrative provider.
# Supported values: "disabled", "openrouter"
# Default in insightops/config.py: "disabled"
INSIGHTOPS_NARRATIVE_PROVIDER=disabled
